#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
//#include <dt-bindings/led/issi,is31fl3733.h>

/ {
    keymap{
        compatible = "zmk,keymap";
        cbc{
            bindings = <
                                                                                                            &kp UP                      &none
            &kp SPACE   &kp HOME    &kp C       &kp D       &kp H           &none           &kp LEFT        &kp DOWN        &kp RIGHT   &none      &none
                                    &none       &none       &none           &kp O           &none           &none           &none     
            &kp LC(N8)  &kp LC(N9)  &kp LC(N2)  &kp LC(N3)  &kp LC(N4)      &kp LC(N5)      &kp LC(N6)      &kp LC(N7)      &kp LC(N1)  &kp PLUS
            &kp N8      &kp N9      &kp N2      &kp N3      &kp N4          &kp N5          &kp N6          &kp N7          &kp N1
            &kp LA(N8)  &kp LA(N9)  &kp LA(N2)  &kp LA(N3)  &kp LA(N4)      &kp LA(N5)      &kp LA(N6)      &kp LA(N7)      &kp LA(N1)
                                                            &kp LC(LA(N1))  &kp LC(LA(N2))  &kp LC(LA(N3))  &kp LC(LA(N4))  &none       &kp MINUS     
            >;
            sensor-bindings = <&inc_dec_kp LS(C) LS(O) &inc_dec_kp LS(C) LS(O) &inc_dec_kp LS(C) LS(O) &inc_dec_kp LS(C) LS(O) &inc_dec_kp LS(C) LS(O)>;
        };
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&sw1_encoder &sw2_encoder &sw3_encoder &sw4_encoder &sw5_encoder>;
        triggers-per-rotation = <2>;
    };

    combos {
        compatible = "zmk,combos";
        
        pgdn {
            timeout-ms = <80>;
            key-positions = <12 11 9>;
            bindings = <&kp PG_DN>;
        };

        pgup{
            timeout-ms = <80>;
            key-positions = <12 11 0>;
            bindings = <&kp PG_UP>;
        };

        shft_pgdn{
            timeout-ms = <80>;
            key-positions = <12 1 11 9>;
            bindings = <&kp LS(PG_DN)>;
        };

        shft_1{
            timeout-ms = <80>;
            key-positions = <9 47>;
            bindings = <&kp LS(N1)>;
        };

        shft_2{
            timeout-ms = <80>;
            key-positions = <11 41>;
            bindings = <&kp LS(N2)>;
        };

        shft_3{
            timeout-ms = <80>;
            key-positions = <11 42>;
            bindings = <&kp LS(N3)>;
        };

        shft_4{
            timeout-ms = <80>;
            key-positions = <11 43>;
            bindings = <&kp LS(N4)>;
        };

        shft_5{
            timeout-ms = <80>;
            key-positions = <11 44>;
            bindings = <&kp LS(N5)>;
        };

        shft_6{
            timeout-ms = <80>;
            key-positions = <11 45>;
            bindings = <&kp LS(N6)>;
        };

        shft_7{
            timeout-ms = <80>;
            key-positions = <11 46>;
            bindings = <&kp LS(N7)>;
        };

        shft_8{
            timeout-ms = <80>;
            key-positions = <11 39>;
            bindings = <&kp LS(N8)>;
        };

        shft_9{
            timeout-ms = <80>;
            key-positions = <11 40>;
            bindings = <&kp LS(N9)>;
        };

        shft_ctrl_1{
            timeout-ms = <80>;
            key-positions = <12 47>;
            bindings = <&kp LS(LC(N1))>;
        };

        shft_ctrl_2{
            timeout-ms = <80>;
            key-positions = <12 41>;
            bindings = <&kp LS(LC(N2))>;
        };

        shft_ctrl_3{
            timeout-ms = <80>;
            key-positions = <21 42>;
            bindings = <&kp LS(LC(N3))>;
        };

        shft_ctrl_4{
            timeout-ms = <80>;
            key-positions = <12 43>;
            bindings = <&kp LS(LC(N4))>;
        };

        shft_ctrl_5{
            timeout-ms = <80>;
            key-positions = <12 44>;
            bindings = <&kp LS(LC(N5))>;
        };

        shft_ctrl_6{
            timeout-ms = <80>;
            key-positions = <12 45>;
            bindings = <&kp LS(LC(N6))>;
        };

        shft_ctrl_7{
            timeout-ms = <80>;
            key-positions = <12 46>;
            bindings = <&kp LS(LC(N7))>;
        };

        shft_ctrl_8{
            timeout-ms = <80>;
            key-positions = <12 39>;
            bindings = <&kp LS(LC(N8))>;
        };

        shft_ctrl_9{
            timeout-ms = <80>;
            key-positions = <12 40>;
            bindings = <&kp LS(LC(N9))>;
        };

        s{
            timeout-ms = <80>;
            key-positions = <12 4>;
            bindings = <&kp S>;   
        };

        alt_s{
            timeout-ms = <80>;
            key-positions = <11 12 4>;
            bindings = <&kp LA(S)>;
        };

        m{
            timeout-ms = <80>;
            key-positions = <12 5>;
            bindings = <&kp M>;
        };

        alt_m{
            timeout-ms = <80>;
            key-positions = <11 12 5>;
            bindings = <&kp LA(M)>;
        };

        ctrl_shift_s{
            timeout-ms = <80>;
            key-positions = <12 1 3>;
            bindings = <&kp LC(LS(S))>;
        };

        esc{
            timeout-ms = <80>;
            key-positions = <11 53>;
            bindings = <&kp ESC>;
        };

        y{
            timeout-ms = <80>;
            key-positions = <11 29>;
            bindings = <&kp Y>;
        };

        l{
            timeout-ms = <80>;
            key-positions = <11 50>;
            bindings = <&kp L>; 
        };

        alt_0{
            timeout-ms = <80>;
            key-positions = <1 47>;
            bindings = <&kp LA(N0)>;    
        };

        p{
            timeout-ms = <80>;
            key-positions = <1 39>;
            bindings = <&kp P>;  
        };

        shft_l{
            timeout-ms = <80>;
            key-positions = <1 7>;
            bindings = <&kp LS(L)>;
        };

        t{
            timeout-ms = <80>;
            key-positions = <1 43>;
            bindings = <&kp T>;  
        };

        i{
            timeout-ms = <80>;
            key-positions = <11 16>;
            bindings = <&kp I>;            
        };

        a{
            timeout-ms = <80>;
            key-positions = <11 17>;
            bindings = <&kp A>;            
        };

        b{
            timeout-ms = <80>;
            key-positions = <11 48>;
            bindings = <&kp B>;            
        };

        r{
            timeout-ms = <80>;
            key-positions = <11 49>;
            bindings = <&kp R>;            
        };       

        h{
            timeout-ms = <80>;
            key-positions = <11 51>;
            bindings = <&kp H>;            
        };        
    };
};

&kscan0 {
    debounce-press-ms = <7>;
    debounce-release-ms = <7>;
};

&sw1_encoder {
    status = "okay";
};

&sw2_encoder {
    status = "okay";
};

&sw3_encoder {
    status = "okay";
};

&sw4_encoder {
    status = "okay";
};

&sw5_encoder {
    status = "okay";
};