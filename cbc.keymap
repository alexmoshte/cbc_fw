#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap{
        compatible = "zmk,keymap";
        layer_0{
            bindings = < 
                        &kp KC_SPC               &kp LC(KC_8)     &kp KC_8  &kp LA(KC_8)  
                        &kp HOME                 &kp LC(KC_9)     &kp KC_9  &kp LA(KC_9)  
                        &kp KC_C      &none      &kp LC(KC_2)     &kp KC_2  &kp LA(KC_2)   
                        &kp KC_D      &none      &kp LC(KC_3)     &kp KC_3  &kp LA(KC_3)   
                        &kp KC_H      &none      &kp LC(KC_4)     &kp KC_4  &kp LA(KC_4)  &kp LC(LA(KC_1)) 
                        &none         &kp KC_O   &kp LC(KC_5)     &kp KC_5  &kp LA(KC_5)  &kp LC(LA(KC_2)) 
                        &kp KC_LEFT   &none      &kp LC(KC_6)     &kp KC_6  &kp LA(KC_6)  &kp LC(LA(KC_3)) 
            &kp KC_UP   &kp KC_DOWN   &none      &kp LC(KC_7)     &kp KC_7  &kp LA(KC_7)  &kp LC(LA(KC_4)) 
                        &kp KC_RIGHT  &none      &kp LC(KC_1)     &kp KC_1  &kp LA(KC_1)  &none
            &none       &none                    &kp LS(K_EQUAL)                          &kp KC_MINUS
                        &none
            >;
            sensor-bindings = <&inc_dec_kp LS(KC_C) LS(KC_O) &inc_dec_kp LS(KC_C) LS(KC_O) &inc_dec_kp LS(KC_C) LS(KC_O) &inc_dec_kp LS(KC_C) LS(KC_O) &inc_dec_kp LS(KC_C) LS(KC_O)>;
        };
    };

    combos {
        compatible = "zmk,combos";
        
        pgdn {
            timeout-ms = <80>;
            key-positions = <53 50 37>;
            bindings = <&kp KC_PGDN>;
        };

        pgup{
            timeout-ms = <80>;
            key-positions = <53 50 36>;
            bindings = <&kp KC_PGUP>;
        };

        shft_pgdn{
            timeout-ms = <80>;
            key-positions = <53 49 50 37>;
            bindings = <&kp LS(KC_PGDN)>;
        };

        shft_1{
            timeout-ms = <80>;
            key-positions = <37 47>;
            bindings = <&kp LS(KC_1)>;
        };

        shft_2{
            timeout-ms = <80>;
            key-positions = <50 12>;
            bindings = <&kp LS(KC_2)>;
        };

