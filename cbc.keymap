#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap{
        compatible = "zmk,keymap";
        layer_0{
            bindings = < 
                    &kp SPACE         &kp LC(N8)  &kp N8  &kp LA(N8)  
                    &kp HOME          &kp LC(N9)  &kp N9  &kp LA(N9)  
                    &kp C      &none  &kp LC(N2)  &kp N2  &kp LA(N2)   
                    &kp D      &none  &kp LC(N3)  &kp N3  &kp LA(N3)   
                    &kp H      &none  &kp LC(N4)  &kp N4  &kp LA(N4)  &kp LC(LA(N1)) 
                    &none      &kp O  &kp LC(N5)  &kp N5  &kp LA(N5)  &kp LC(LA(N2)) 
                    &kp LEFT   &none  &kp LC(N6)  &kp N6  &kp LA(N6)  &kp LC(LA(N3)) 
            &kp UP  &kp DOWN   &none  &kp LC(N7)  &kp N7  &kp LA(N7)  &kp LC(LA(N4)) 
                    &kp RIGHT  &none  &kp LC(N1)  &kp N1  &kp LA(N1)  &none
            &none   &none             &kp PLUS                        &kp MINUS
                    &none
            >;
            sensor-bindings = <&inc_dec_kp LS(C) LS(O) &inc_dec_kp LS(C) LS(O) &inc_dec_kp LS(C) LS(O) &inc_dec_kp LS(C) LS(O) &inc_dec_kp LS(C) LS(O)>;
        };
    };

    combos {
        compatible = "zmk,combos";
        
        pgdn {
            timeout-ms = <80>;
            key-positions = <53 50 37>;
            bindings = <&kp PG_DN>;
        };

        pgup{
            timeout-ms = <80>;
            key-positions = <53 50 36>;
            bindings = <&kp PG_UP>;
        };

        shft_pgdn{
            timeout-ms = <80>;
            key-positions = <53 49 50 37>;
            bindings = <&kp LS(PG_DN)>;
        };

        shft_1{
            timeout-ms = <80>;
            key-positions = <37 47>;
            bindings = <&kp LS(N1)>;
        };

        shft_2{
            timeout-ms = <80>;
            key-positions = <50 12>;
            bindings = <&kp LS(N2)>;
        };

        shft_3{
            timeout-ms = <80>;
            key-positions = <50 17>;
            bindings = <&kp LS(N3)>;
        };

        shft_4{
            timeout-ms = <80>;
            key-positions = <50 22>;
            bindings = <&kp LS(N4)>;
        };

        shft_5{
            timeout-ms = <80>;
            key-positions = <50 28>;
            bindings = <&kp LS(N5)>;
        };

        shft_6{
            timeout-ms = <80>;
            key-positions = <50 34>;
            bindings = <&kp LS(N6)>;
        };

        shft_7{
            timeout-ms = <80>;
            key-positions = <50 41>;
            bindings = <&kp LS(N7)>;
        };

        shft_8{
            timeout-ms = <80>;
            key-positions = <50 3>;
            bindings = <&kp LS(N8)>;
        };

        shft_9{
            timeout-ms = <80>;
            key-positions = <50 7>;
            bindings = <&kp LS(N9)>;
        };

        shft_ctrl_1{
            timeout-ms = <80>;
            key-positions = <53 47>;
            bindings = <&kp LS(LC(N1))>;
        };

        shft_ctrl_2{
            timeout-ms = <80>;
            key-positions = <53 12>;
            bindings = <&kp LS(LC(N2))>;
        };

        shft_ctrl_3{
            timeout-ms = <80>;
            key-positions = <53 17>;
            bindings = <&kp LS(LC(N3))>;
        };

        shft_ctrl_4{
            timeout-ms = <80>;
            key-positions = <53 22>;
            bindings = <&kp LS(LC(N4))>;
        };

        shft_ctrl_5{
            timeout-ms = <80>;
            key-positions = <53 28>;
            bindings = <&kp LS(LC(N5))>;
        };

        shft_ctrl_6{
            timeout-ms = <80>;
            key-positions = <53 34>;
            bindings = <&kp LS(LC(N6))>;
        };

        shft_ctrl_7{
            timeout-ms = <80>;
            key-positions = <53 41>;
            bindings = <&kp LS(LC(N7))>;
        };

        shft_ctrl_8{
            timeout-ms = <80>;
            key-positions = <53 3>;
            bindings = <&kp LS(LC(N8))>;
        };

        shft_ctrl_9{
            timeout-ms = <80>;
            key-positions = <53 7>;
            bindings = <&kp LS(LC(N9))>;
        };

        s{
            timeout-ms = <80>;
            key-positions = <53 8>;
            bindings = <&kp S>;   
        };

        alt_s{
            timeout-ms = <80>;
            key-positions = <50 53 8>;
            bindings = <&kp LA(S)>;
        };

        m{
            timeout-ms = <80>;
            key-positions = <53 13>;
            bindings = <&kp M>;
        };

        alt_m{
            timeout-ms = <80>;
            key-positions = <50 53 13>;
            bindings = <&kp LA(M)>;
        };

        ctrl_shift_s{
            timeout-ms = <80>;
            key-positions = <53 49 4>;
            bindings = <&kp LC(LS(S))>;
        };

        esc{
            timeout-ms = <80>;
            key-positions = <50 52>;
            bindings = <&kp ESC>;
        };

        y{
            timeout-ms = <80>;
            key-positions = <50 51>;
            bindings = <&kp Y>;
        };

        l{
            timeout-ms = <80>;
            key-positions = <50 35>;
            bindings = <&kp L>; 
        };

        alt_0{
            timeout-ms = <80>;
            key-positions = <49 47>;
            bindings = <&kp LA(N0)>;    
        };

        p{
            timeout-ms = <80>;
            key-positions = <49 3>;
            bindings = <&kp P>;  
        };

        shft_l{
            timeout-ms = <80>;
            key-positions = <49 24>;
            bindings = <&kp LS(L)>;
        };

        t{
            timeout-ms = <80>;
            key-positions = <49 22>;
            bindings = <&kp T>;  
        };

        i{
            timeout-ms = <80>;
            key-positions = <50 25>;
            bindings = <&kp I>;            
        };

        a{
            timeout-ms = <80>;
            key-positions = <50 31>;
            bindings = <&kp A>;            
        };

        b{
            timeout-ms = <80>;
            key-positions = <50 23>;
            bindings = <&kp B>;            
        };

        r{
            timeout-ms = <80>;
            key-positions = <50 29>;
            bindings = <&kp R>;            
        };       

        h{
            timeout-ms = <80>;
            key-positions = <50 42>;
            bindings = <&kp H>;            
        };        
    };
};

&kscan0 {
    debounce-press-ms = <7>;
    debounce-release-ms = <7>;
};

&sw1_encoder {
    status = "okay";
};

&sw2_encoder {
    status = "okay";
};

&sw3_encoder {
    status = "okay";
};

&sw4_encoder {
    status = "okay";
};

&sw5_encoder {
    status = "okay";
};