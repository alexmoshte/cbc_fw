/dts-v1/;

#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>

#include <dt-bindings/zmk/matrix_transform.h>
#include <layouts/common/ortho_4x12/all1u.dtsi>

/ {
    model = "A HID device for interracting with the chordboard application via USB and BLE";
    compatible = "chordboard,cbc", "nordic,nrf52840";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash;
        zephyr,udc = &usbd;
        zephyr,code-partition = &slot0_partition;
        zmk,kscan = &kscan0;
        zmk,backlight = &backlight;
        zmk,physical-layout = &layout_ortho_4x12_all1u;
        zmk,battery = &vbatt;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 2>;
        output-ohms = <2000000>;
        full-ohms = <(2000000 + 820000)>;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios
            = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 03 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 01 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 02 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
        col-gpios
            = <&gpio1 13 GPIO_ACTIVE_HIGH>
            , <&gpio0 15 GPIO_ACTIVE_HIGH>
            , <&gpio1 10 GPIO_ACTIVE_HIGH>
            , <&gpio0 14 GPIO_ACTIVE_HIGH>
            , <&gpio1 07 GPIO_ACTIVE_HIGH>
            , <&gpio0 24 GPIO_ACTIVE_HIGH>
            , <&gpio1 05 GPIO_ACTIVE_HIGH>
            , <&gpio0 20 GPIO_ACTIVE_HIGH>
            , <&gpio0 17 GPIO_ACTIVE_HIGH>
            , <&gpio0 16 GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            ;
    };

    layout_grid_transform: keymap_transform_0 {    
        compatible = "zmk,matrix-transform";
        rows = <7>;
        columns = <11>;
        map = <
                                                                          RC(0,7)           RC(0,9)   
            RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6) RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10)
                              RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6) RC(2,7)  RC(2,8)    
            RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6) RC(3,7)  RC(3,8)  RC(3,9)  
            RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)  RC(4,6) RC(4,7)  RC(4,8)   
            RC(5,0)  RC(5,1)  RC(5,2)  RC(5,3)  RC(5,4)  RC(5,5)  RC(5,6) RC(5,7)  RC(5,8)    
                                                RC(6,4)  RC(6,5)  RC(6,6) RC(6,7)  RC(6,8)  RC(6,9)  
        >;
    };

    sw1_encoder: encoder_sw1 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <18>;
        status = "enabled";
    };

    sw2_encoder: encoder_sw2 {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <18>;
        status = "enabled";
    };

    sw3_encoder: encoder_sw3 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <18>;
        status = "enabled";
    };

    sw4_encoder: encoder_sw4 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <18>;
        status = "enabled";
    };

    sw5_encoder: encoder_sw5 {
        compatible = "alps,ec11";
        a-gpios = <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 27 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <18>;
        status = "enabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&sw1_encoder &sw2_encoder &sw3_encoder &sw4_encoder &sw5_encoder>;
        triggers-per-rotation = <2>;
    };
};

&adc {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&usbd {
    compatible = "nordic,nrf-usbd";
    status = "okay";
};

zephyr_udc0: &usbd {};

&sw1_encoder {
    status = "okay";
};

&sw2_encoder {
    status = "okay";
};

&sw3_encoder {
    status = "okay";
};

&sw4_encoder {
    status = "okay";
};

&sw5_encoder {
    status = "okay";
};

&layout_ortho_4x12_all1u {
    transform = <&layout_grid_transform>;
};


&i2c0 {
    status = "okay";
    scl-pin = <&gpio0 5>;
    sda-pin = <&gpio0 7>;

    is31fl3733_drv1: is31fl3733_drv1@50 {
        compatible = "issi,is31fl3733";
        status = "okay";
        reg = <0x50>;
        issi,sdb-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;
        issi,shutdown-current = <IS31FL3733_SSD_1UA>;
        issi,current-limit = <IS31FL3733_CS_10MA>;
        sync-mode = "slave";
        #address-cells = <1>;
        #size-cells = <0>;

        blue1@0 {
            reg = <0>;
            issi,pwm-register = <0x00>;
        };

        red1@1 {
            reg = <1>;
            issi,pwm-register = <0x01>;
        };

        green1@2 {
            reg = <2>;
            issi,pwm-register = <0x02>;
        };

        blue2@3 {
            reg = <3>;
            issi,pwm-register = <0x03>;
        };

        green2@4 {
            reg = <4>;
            issi,pwm-register = <0x04>;
        };

        red2@5 {
            reg = <5>;
            issi,pwm-register = <0x05>;
        };


        blue3@6 {
            reg = <6>;
            issi,pwm-register = <0x06>;
        };

        green3@7 {
            reg = <7>;
            issi,pwm-register = <0x07>;
        };

        red3@8 {
            reg = <8>;
            issi,pwm-register = <0x08>;
        };
    };
};

&i2c1 {
    status = "okay";
    scl-pin = <&gpio0 4>;
    sda-pin = <&gpio0 31>;

    is31fl3733_drv2: is31fl373_drv2@50 {
        compatible = "issi,is31fl3733";
        status = "okay";
        reg = <0x50>;
        issi,sdb-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;
        issi,shutdown-current = <IS31FL3733_SSD_1UA>;
        issi,current-limit = <IS31FL3733_CS_10MA>;
        sync-mode = "slave";
        #address-cells = <1>;
        #size-cells = <0>;

        blue4@0 {
            reg = <0>;
            issi,pwm-register = <0x00>;
        };

        red4@1 {
            reg = <1>;
            issi,pwm-register = <0x01>;
        };

        green4@2 {
            reg = <2>;
            issi,pwm-register = <0x02>;
        };

        blue5@3 {
            reg = <3>;
            issi,pwm-register = <0x03>;
        };

        green5@4 {
            reg = <4>;
            issi,pwm-register = <0x04>;
        };

        red5@5 {
            reg = <5>;
            issi,pwm-register = <0x05>;
        };


        blue6@6 {
            reg = <6>;
            issi,pwm-register = <0x06>;
        };

        green6@7 {
            reg = <7>;
            issi,pwm-register = <0x07>;
        };

        red6@8 {
            reg = <8>;
            issi,pwm-register = <0x08>;
        };
    };
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(48)>;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 DT_SIZE_K(472)>;
		};

		slot1_partition: partition@82000 {
			label = "image-1";
			reg = <0x00082000 DT_SIZE_K(472)>;
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 DT_SIZE_K(32)>;
		};
	};
};
