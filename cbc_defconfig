# Enable MPU
# CONFIG_ARM_MPU=y
# CONFIG_USE_DT_CODE_PARTITION=y
# CONFIG_SOC_NRF52840_QIAA=y

# USB configuration
CONFIG_ZMK_USB=y
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_DEVICE_DRIVER=y
# CONFIG_USB=y
# CONFIG_USB_NRFX=y
# CONFIG_USB_DEVICE_STACK=y
# CONFIG_USB_DEVICE_CONTROLLER=y
# CONFIG_USB_DEVICE_DESCRIPTOR=y
CONFIG_USB_DEVICE_MANUFACTURER="chordboard"
CONFIG_USB_CDC_ACM=y
# CONFIG_ZMK_USB=y

# BT configuration
CONFIG_BT=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_DEVICE_NAME="CBC"
CONFIG_ZMK_BLE=y
CONFIG_ZMK_BLE_CLEAR_BONDS_ON_START=y
# CONFIG_BT_CTLR_TX_PWR_PLUS_8=y
# CONFIG_BT_CTLR_TX_PWR=8
CONFIG_BT_CTLR_PHY_2M=n
# CONFIG_ZMK_BLE_PASSKEY_ENTRY=y
# CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

CONFIG_BT_MAX_CONN=2
CONFIG_BT_MAX_PAIRED=2
# CONFIG_BT_BUF_ACL_RX_SIZE=251
# CONFIG_BT_BUF_ACL_TX_SIZE=251
# CONFIG_BT_DATA_LEN_UPDATE=y

# Log configurations
CONFIG_LOG=y
CONFIG_ZMK_USB_LOGGING=y
# CONFIG_ZMK_LOG_LEVEL=4
CONFIG_LOG_DEFAULT_LEVEL=4
CONFIG_LOG_PROCESS_THREAD_STARTUP_DELAY_MS=8000

# Enable GPIO
CONFIG_GPIO=y
CONFIG_PINCTRL=y

# Clock configuration
CONFIG_CLOCK_CONTROL=y

# Encoder support
CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y
# CONFIG_EC11_TRIGGER_OWN_THREAD=y

#Build configuration
CONFIG_BUILD_OUTPUT_UF2=n
# CONFIG_ZMK_SETTINGS_RESET_ON_START=y

# HID report configuration
CONFIG_ZMK_HID_REPORT_TYPE_HKRO=y

#Battery reporting
CONFIG_ZMK_BATTERY_REPORTING=y
# CONFIG_ZMK_BATTERY_REPORTING_INTERVAL_MS=600




